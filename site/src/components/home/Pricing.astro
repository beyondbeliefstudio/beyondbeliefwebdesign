---
// COMPONENTS
import Heading from "@/components/Heading.astro";
import Links from "@/components/Links.astro";

// DATA
// Homepage shows the glimpse only — two prices and five bullets each.
// The full feature tables, add-ons, and comparison live on the parked _services.astro page.
import { plans } from "@/data/pricingData";
---

<section id="pricing" class="sec-pad">
  <div class="container container-md">
    <div class="section-head" data-reveal>
      <span class="eyebrow"
        ><span class="cmt" aria-hidden="true">/*</span>Pricing<span class="cmt" aria-hidden="true"
          >*/</span
        ></span
      >
      <Heading tag="h2" size="xl" fontFamily="primary" marginBottom="s" weight="fw700">
        Two plans. Nothing upfront.
      </Heading>
      <p class="lead">
        Most web designers charge thousands before they write a line of code, bill you for every
        change, and disappear after launch. <strong>That's not how I work.</strong>
      </p>
    </div>

    <div class="tier-grid" data-reveal>
      {
        plans.map((plan, i) => (
          <article class:list={["tier", i === 1 && "tier--dark"]}>
            {i === 1 && <span class="tier-glow" aria-hidden="true" />}
            <div class="tier-in">
              <div class="tier-head">
                <span class="tier-name">{plan.name}</span>
                {i === 1 && <span class="tier-flag">Competes in search</span>}
              </div>

              <div class="price-big">
                <sup>$</sup>
                <span>{plan.price}</span> <small>{plan.cadence}</small>
              </div>
              <span class="tier-terms">{plan.terms}</span>

              <p class="tier-tag">{plan.tagline}</p>

              <ul class="tlist">
                {plan.highlights.map(item => (
                  <li>
                    <span class="tk">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="tier-foot" data-reveal>
      <p class="tf-copy">
        Every plan includes hosting, unlimited content updates, and a real person who answers.
        <strong>You own your domain, your hosting, and your analytics from day one.</strong>
      </p>
      <div class="tf-actions">
        <Links variant="primary" href="#contact">Let's talk</Links>
      </div>
      <p class="tf-free">
        Not ready to commit? I'll design your homepage completely free, so you can see exactly what
        your site could look like before you decide anything.
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  .tier-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--_spacing---space--7);
    align-items: stretch;
  }

  .tier {
    position: relative;
    display: flex;
    overflow: hidden;
    padding: clamp(28px, 3.2vw, 44px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }
  .tier--dark {
    color: var(--paper);
    background: var(--ink-900);
    border-color: var(--ink-900);
  }
  .tier-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(420px 300px at 18% 115%, rgba(204, 255, 0, 0.24), transparent 65%);
  }
  .tier-in {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .tier-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--_spacing---space--5);
    margin-bottom: var(--_spacing---space--7);
  }
  .tier-name {
    font: 700 0.66rem/1 var(--mono-family);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--fg3);

    .tier--dark & {
      color: var(--stone-300);
    }
  }
  /* Sits on the dark card only, where lime-on-ink clears contrast easily. */
  .tier-flag {
    padding: 5px 9px;
    font: 700 0.62rem/1 var(--mono-family);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--lime);
    border: 1.5px solid var(--lime);
    border-radius: var(--radius-sm);
  }

  .price-big {
    font: 800 clamp(2.9rem, 4.6vw, 4.2rem)/1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--fg1);
    font-variant-numeric: tabular-nums;

    .tier--dark & {
      color: var(--paper);
    }
    sup {
      font-size: 0.38em;
      font-weight: 700;
      vertical-align: super;
      color: var(--fg1);
    }
    .tier--dark & sup {
      color: var(--lime);
    }
    small {
      font-size: 0.28em;
      font-weight: 500;
      letter-spacing: 0;
      color: var(--fg3);
    }
    .tier--dark & small {
      color: var(--stone-300);
    }
  }

  /* Lime is never a text color on cream (1.8:1). Where the accent is wanted
     on a light surface it becomes a chip: ink text on a lime ground. */
  .tier-terms {
    /* A flex item in a column stretches to the card width by default, so the
       chip has to opt out to shrink-wrap its text. */
    display: inline-block;
    align-self: flex-start;
    margin-top: var(--_spacing---space--6);
    padding: 6px 10px;
    font: 700 0.66rem/1 var(--mono-family);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-900);
    background: var(--lime);
    border: 1.5px solid var(--ink-900);
    border-radius: var(--radius-sm);
  }

  .tier-tag {
    max-width: 34ch;
    margin: var(--_spacing---space--6) 0 var(--_spacing---space--7);
    padding-bottom: var(--_spacing---space--7);
    font: 500 0.9375rem/1.55 var(--font-body);
    color: var(--fg2);
    border-bottom: 1px solid var(--border);

    .tier--dark & {
      color: var(--stone-200);
      border-bottom-color: var(--ink-600);
    }
  }

  .tlist {
    display: flex;
    flex-direction: column;
    gap: var(--_spacing---space--5);
    margin: 0;
    padding: 0;
    list-style: none;

    li {
      display: flex;
      align-items: flex-start;
      gap: var(--_spacing---space--5);
      font: 500 0.9375rem/1.45 var(--font-body);
      color: var(--fg1);
    }
    .tier--dark & li {
      color: var(--stone-100);
    }
    .tk {
      flex: none;
      display: grid;
      place-items: center;
      width: 21px;
      height: 21px;
      margin-top: 1px;
      font-size: 12px;
      font-weight: 700;
      color: var(--ink-900);
      background: var(--lime);
      border: 1.5px solid var(--ink-900);
      border-radius: 5px;
    }
  }

  .tier-foot {
    margin-top: var(--_spacing---space--8);
    padding: clamp(24px, 2.8vw, 36px);
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }
  .tf-copy {
    max-width: 72ch;
    margin: 0 auto var(--_spacing---space--7);
    font: 400 0.9375rem/1.6 var(--font-body);
    color: var(--fg2);
    text-wrap: balance;

    strong {
      color: var(--fg1);
    }
  }
  .tf-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--_spacing---space--5);
  }
  .tf-free {
    max-width: 64ch;
    margin: var(--_spacing---space--7) auto 0;
    padding-top: var(--_spacing---space--7);
    font: 400 13.5px/1.55 var(--font-body);
    color: var(--fg3);
    text-wrap: balance;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .tier-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
