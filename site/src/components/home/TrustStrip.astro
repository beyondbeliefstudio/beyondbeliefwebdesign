---
// COMPONENTS
import Icon from "@/components/Icon.astro";
---

<section id="trust">
  <div class="container container-full">
    <div class="trust-grid">
      <div class="item">
        <span class="ic"><Icon name="code" /></span>
        <span class="t">Hand-coded, never generated</span>
      </div>
      <div class="item">
        <span class="ic"><Icon name="bolt" /></span>
        <span class="t">Loads in under a second</span>
      </div>
      <div class="item">
        <span class="ic"><Icon name="shield" /></span>
        <span class="t">You own everything, day one</span>
      </div>
      <div class="item">
        <span class="ic"><Icon name="pin" /></span>
        <span class="t">Based in Monroe, NC</span>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  #trust {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .trust-grid .item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--_spacing---space--6);
    padding: var(--_spacing---space--8) var(--_spacing---space--7);
  }
  .trust-grid .item + .item {
    border-left: 1px solid var(--border);
  }
  .trust-grid .ic {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--lime-deep);
  }
  .trust-grid .ic :global(svg) {
    width: 100%;
    height: 100%;
  }
  .trust-grid .t {
    font: 600 15px/1.3 var(--font-body);
    color: var(--fg1);
  }
  /* Two-up between tablet and desktop: the divider moves from every item to
     the even ones, and rows 2+ pick up a top rule instead. */
  @media (max-width: 1100px) and (min-width: 861px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .trust-grid .item + .item {
      border-left: 0;
    }
    .trust-grid .item:nth-child(even) {
      border-left: 1px solid var(--border);
    }
    .trust-grid .item:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  @media (max-width: 860px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }
    .trust-grid .item + .item {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
    .trust-grid .item {
      padding: var(--_spacing---space--7) var(--_spacing---space--3);
    }
  }
</style>
