---
// BB contact form. Netlify-wired with a honeypot. Fields follow the handoff:
// name / business / email / (optional phone) / "what does your business do?".
// Each .field is a <label> wrapping its input for implicit association.
// Spam: Netlify's honeypot plus Netlify-managed reCAPTCHA v2. Netlify swaps the
// data-netlify-recaptcha div for the Google widget at deploy time and verifies the
// token server-side, so no keys live here and the widget does not appear in local dev.
import Buttons from "@/components/Buttons.astro";

interface Props {
  name?: string;
  includePhone?: boolean;
  submitText?: string;
  messageLabel?: string;
  messagePlaceholder?: string;
}
const {
  name = "contact",
  includePhone = false,
  submitText = "Get started today",
  messageLabel = "What does your business do?",
  messagePlaceholder = "",
} = Astro.props;

const fid = (s: string) => `${name}-${s}`;
---

<form
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-netlify-recaptcha="true"
  name={name}
  method="POST"
  action="/submit-contact"
>
  <input type="hidden" name="form-name" value={name} />
  <p class="hidden" aria-hidden="true">
    <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <label class="field" for={fid("name")}>
    <span class="fl">Your name</span>
    <input type="text" id={fid("name")} name="name" placeholder="Jane Smith" required />
  </label>

  <label class="field" for={fid("business")}>
    <span class="fl">Your business name</span>
    <input type="text" id={fid("business")} name="business" placeholder="Smith & Co." />
  </label>

  <label class="field" for={fid("email")}>
    <span class="fl">Your email</span>
    <input type="email" id={fid("email")} name="email" placeholder="jane@example.com" required />
  </label>

  {
    includePhone && (
      <label class="field" for={fid("phone")}>
        <span class="fl">
          Your phone number <span class="opt">(optional)</span>
        </span>
        <input type="tel" id={fid("phone")} name="phone" placeholder="(980) 290-7034" />
      </label>
    )
  }

  <label class="field" for={fid("message")}>
    <span class="fl">{messageLabel}</span>
    <textarea
      id={fid("message")}
      name="message"
      rows={includePhone ? 4 : 3}
      placeholder={messagePlaceholder}></textarea>
  </label>

  <div class="form-recaptcha" data-netlify-recaptcha="true"></div>
  <p class="form-error" role="alert" hidden>
    Please check the “I’m not a robot” box so I know you’re a real person.
  </p>

  <Buttons variant="primary" classes="form-submit">
    {submitText}
    <span class="arr" aria-hidden="true">→</span>
  </Buttons>
</form>

<style is:global>
  form .form-submit {
    align-self: flex-start;
    margin-top: 8px;
  }
  /* Google's widget is a fixed 304×78 iframe. Reserve its height so the button
     doesn't jump when it loads. Below ~420px the form card is narrower than the
     widget (262px at a 360px viewport), so scale it down rather than crop it. */
  form .form-recaptcha {
    min-height: 78px;
  }
  /* Tangerine text fails contrast on the cream card, so the error is ink text on
     a tangerine wash with a tangerine edge (same idea as lime chips on cream). */
  form .form-error {
    margin: 8px 0 0;
    padding: 10px 14px;
    font: 500 0.8125rem/1.45 var(--font-body);
    color: var(--fg1);
    background: var(--tangerine-wash);
    border-left: 3px solid var(--tangerine-deep);
    border-radius: var(--radius-sm);
  }
  form .form-error[hidden] {
    display: none;
  }
  /* A transform doesn't shrink layout, so the scaled widget gets a fixed height
     to avoid leaving the unscaled 78px of space behind it. */
  @media (max-width: 420px) {
    form .form-recaptcha {
      height: 66px;
      min-height: 0;
    }
    form .form-recaptcha > div {
      transform: scale(0.85);
      transform-origin: 0 0;
    }
  }
  @media (max-width: 350px) {
    form .form-recaptcha {
      height: 56px;
    }
    form .form-recaptcha > div {
      transform: scale(0.72);
    }
  }
</style>

<script>
  // Without this, an un-ticked reCAPTCHA still submits and Netlify rejects it with
  // a bare error page. Stop the submit here and explain instead. Only blocks when
  // the widget actually rendered (its response field exists); if Google's script
  // failed to load, the form submits as before and Netlify decides.
  document.querySelectorAll<HTMLFormElement>("form[data-netlify-recaptcha]").forEach(form => {
    const error = form.querySelector<HTMLElement>(".form-error");
    if (!error) return;
    const token = () =>
      form.querySelector<HTMLTextAreaElement>('[name="g-recaptcha-response"]');

    // reCAPTCHA fills its field programmatically (no input event), so watch for it
    // while the error is showing and clear the error once the box is ticked.
    let watch = 0;
    const clear = () => {
      error.hidden = true;
      window.clearInterval(watch);
      watch = 0;
    };

    form.addEventListener("submit", e => {
      const field = token();
      if (!field || field.value) return;
      e.preventDefault();
      error.hidden = false;
      if (!watch) {
        watch = window.setInterval(() => {
          if (token()?.value) clear();
        }, 400);
      }
    });
  });
</script>
